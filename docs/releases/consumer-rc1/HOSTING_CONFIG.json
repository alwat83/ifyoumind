{
  "hosting": {
    "public": "public",
    "cleanUrls": true,
    "redirects": [
      {
        "regex": "^/(sample-report|privacy-policy|terms-of-conduct|login|register|verify-email|app)/+$",
        "destination": "/:1",
        "type": 301
      },
      {
        "regex": "^/guides$",
        "destination": "/guides/",
        "type": 301
      },
      {
        "regex": "^/guides/([a-z0-9]+(?:-[a-z0-9]+)*)$",
        "destination": "/guides/:1/",
        "type": 301
      },
      {
        "regex": "^/discover$",
        "destination": "/discover/",
        "type": 301
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/login",
        "destination": "/app-shell.html"
      },
      {
        "source": "/register",
        "destination": "/app-shell.html"
      },
      {
        "source": "/verify-email",
        "destination": "/app-shell.html"
      },
      {
        "regex": "^/(?:decisions(?:/[A-Za-z0-9_-]{1,128})?|decide|pricing|growth|account|data|ask|advanced)/?$",
        "destination": "/app-shell.html"
      },
      {
        "regex": "^/app(?:/(?:result/[A-Za-z0-9_-]{1,128}|decide|pricing|growth|account|data|ask|advanced))?/?$",
        "destination": "/app-shell.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          }
        ]
      },
      {
        "regex": "^/(?:[^_].*|_[^_].*|_)?$",
        "headers": [
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
          }
        ]
      },
      {
        "source": "/discover/**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'none'; font-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
          },
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          },
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          },
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      }
    ],
    "site": "ifyoumind-473fe"
  }
}
