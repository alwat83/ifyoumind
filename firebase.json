{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "dist/ifyoumind-deploy/browser",
    "cleanUrls": true,
    "redirects": [
      { "regex": "^/(sample-report|privacy-policy|terms-of-conduct|login|register|verify-email|app)/+$", "destination": "/:1", "type": 301 },
      { "regex": "^/guides$", "destination": "/guides/", "type": 301 },
      { "regex": "^/guides/([a-z0-9]+(?:-[a-z0-9]+)*)$", "destination": "/guides/:1/", "type": 301 }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/login",
        "destination": "/app-shell.html"
      },
      { "source": "/register", "destination": "/app-shell.html" },
      { "source": "/verify-email", "destination": "/app-shell.html" },
      { "source": "/app", "destination": "/app-shell.html" },
      { "source": "/app/**", "destination": "/app-shell.html" }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          }
        ]
      },
      {
        "regex": "^/(?:[^_].*|_[^_].*|_)?$",
        "headers": [
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
          }
        ]
      }
    ]
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": {
      "host": "127.0.0.1",
      "port": 9099
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080
    },
    "functions": {
      "host": "127.0.0.1",
      "port": 5001
    },
    "storage": {
      "host": "127.0.0.1",
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "host": "127.0.0.1",
      "port": 4000
    },
    "singleProjectMode": true
  }
}
