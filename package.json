{
  "name": "ifyoumind",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "node scripts/generate-sitemap.js && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "tailwind:init": "tailwindcss init -p",
    "start:local": "ng serve --configuration local",
    "build:local": "ng build --configuration local",
    "emulators": "npm --prefix functions run build && firebase emulators:start --project demo-ifyoumind --only auth,firestore,functions,storage",
    "test:rules": "firebase emulators:exec --project demo-ifyoumind --only firestore \"node --test test/intelligence.rules.test.mjs\"",
    "test:foundation": "npm --prefix functions test && npm run test:rules && npm run test:organizations",
    "test:organizations": "npm --prefix functions run build && firebase emulators:exec --project demo-ifyoumind --only auth,firestore \"node --test test/organizations.integration.test.mjs\""
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/fire": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "firebase": "^12.3.0",
    "ngx-joyride": "^2.5.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.5",
    "@angular/cli": "^19.2.5",
    "@angular/compiler-cli": "^19.2.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "20.3.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.35.0",
    "firebase-admin": "^12.2.0",
    "firebase-tools": "^13.35.1",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.13",
    "typescript": "~5.7.2",
    "typescript-eslint": "8.40.0"
  },
  "resolutions": {
    "postcss": "8.5.6",
    "autoprefixer": "10.4.21"
  }
}
